# Copy to .env for local development. On Render, set these in the service's Environment page instead.
# Every project built on Foundation uses the same names. Lines that are commented out show the default.

# --- Identity and branding --------------------------------------------------------------------
APP_NAME=The Cornerstone
APP_TAGLINE=Restoring livelihoods government deliberately destroyed
APP_ORGANIZATION=Galinsky 2028
APP_BRAND_COLOR=#1f3a5f
# APP_CONTACT_EMAIL=

# --- Web --------------------------------------------------------------------------------------
# The address people use to reach the site. Links in emails are built from it.
APP_BASE_URL=http://localhost:8000
# Required at any public address: a long random value (python -c "import secrets; print(secrets.token_hex(32))").
# Left empty on a local machine, a key is generated and kept in the data directory.
APP_SECRET_KEY=
# true only behind a proxy you control (Render, Caddy); makes rate limits use the visitor's real address.
# APP_TRUST_PROXY=false
# APP_SESSION_DAYS=30
# APP_MAX_UPLOAD_MB=50
# closed = only administrators add users; invite = administrators send invitation links; open = anyone may register.
# The Cornerstone uses open, so workers can create their own accounts.
APP_REGISTRATION=open
# true only for testing against local servers: lets foundation.net fetch private addresses.
# APP_ALLOW_PRIVATE_URLS=false

# --- The Cornerstone --------------------------------------------------------------------------
# preview = the Act is not law (example world, preview accounts, warnings); enacted = the Act is in force.
# Only the first start reads this. Afterwards the password-protected switch at /site decides.
APP_LEGAL_MODE=preview

# --- First administrator (created once, on first start, when no users exist) ------------------
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=

# --- Storage ----------------------------------------------------------------------------------
# Empty = a SQLite file in APP_DATA_DIR. In production, the Neon pooled connection string (host contains -pooler)
# and the direct one, which migrations use.
# APP_DATA_DIR=./data
# APP_DATABASE_URL=
# APP_DATABASE_URL_DIRECT=

# --- Email ------------------------------------------------------------------------------------
# console writes each message to APP_DATA_DIR/outbox and the log; smtp sends it.
# APP_EMAIL_BACKEND=console
# APP_EMAIL_FROM=
# APP_SMTP_HOST=
# APP_SMTP_PORT=587
# APP_SMTP_USER=
# APP_SMTP_PASSWORD=
# APP_SMTP_STARTTLS=true

# --- AI (optional; the Cornerstone does not use it) -------------------------------------------
# APP_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# APP_LLM_MODEL=claude-sonnet-5-5
# APP_LLM_MAX_TOKENS=4000
# APP_MONTHLY_BUDGET_USD=20

# --- Background worker ------------------------------------------------------------------------
# One worker runs inside the web process. It rebuilds the preview's example world each night.
# APP_RUN_WORKER=true
